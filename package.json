{
  "name": "acog-tweaks",
  "version": "0.1.0",
  "description": "A local-first, reversible Windows tuning workspace",
  "author": "ACOG Tweaks contributors",
  "license": "MIT",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "dist:win": "electron-builder --win nsis zip --x64",
    "dist:linux": "electron-builder --linux dir",
    "format": "prettier --write app scripts tests",
    "format:check": "prettier --check app scripts tests"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10"
  },
  "build": {
    "appId": "com.acog.tweaks",
    "productName": "ACOG Tweaks",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "app/assets/icon.ico",
      "uninstallerIcon": "app/assets/icon.ico"
    },
    "linux": {
      "target": "dir"
    }
  }
}
